#!/usr/bin/env python3
"""Run Bastet from the checkout:  ./bastet logs /var/log/auth.log

The package lives in src/ so this launcher can be called `bastet` — a file and a
folder of the same name cannot share a directory.
"""

import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

try:
    from bastet.cli import main
except ModuleNotFoundError as exc:  # pragma: no cover - environment problem
    if "rich" in str(exc):
        sys.exit(
            "Bastet needs rich for its output:\n"
            "    pip install rich\n"
            "or install the package:  pip install -e ."
        )
    raise

if __name__ == "__main__":
    raise SystemExit(main())
